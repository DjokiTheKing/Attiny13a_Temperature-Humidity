    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Arduino) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "avrdude",
            "args": [
                "-N",
                "-v",
                "-pattiny13a",
                "-PCOM9",
                "-cstk500v1", 
                "-b19200",
                "-Uhfuse:w:0xfb:m",
                "-Ulfuse:w:0b00111010:m",
                "-Uflash:w:main.hex:i"
			],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\build",
            "environment": [],
            "console": "externalTerminal"
        }
    ]
}